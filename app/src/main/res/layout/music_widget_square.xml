<?xml version="1.0" encoding="utf-8"?>
<!-- 2x2: Portada cuadrada dominante con gradiente inferior, título/artista superpuesto
          y botón play/pause centrado sobre la portada. Inspirado en iOS lock screen widget. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background">

    <!-- Portada full-bleed -->
    <ImageView
        android:id="@+id/widget_album_art"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/widget_album_art_bg"
        android:clipToOutline="true"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_monkey_head" />

    <!-- Gradiente oscuro en la mitad inferior para legibilidad del texto -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/widget_gradient_overlay" />

    <!-- Texto en la parte inferior -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="60dp"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/widget_song_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:text="Monkey Player"
            android:textColor="#FFFFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_song_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:text="Not playing"
            android:textColor="#BBFFFFFF"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Controles: prev + play/pause + next superpuestos en esquina inferior derecha -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingEnd="10dp"
        android:paddingBottom="8dp">

        <ImageButton
            android:id="@+id/widget_prev"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:background="@android:color/transparent"
            android:contentDescription="Previous"
            android:padding="5dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_skip_previous" />

        <ImageButton
            android:id="@+id/widget_play_pause"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/widget_btn_bg"
            android:contentDescription="Play/Pause"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_play"
            android:tint="#FF000000" />

        <ImageButton
            android:id="@+id/widget_next"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:background="@android:color/transparent"
            android:contentDescription="Next"
            android:padding="5dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_skip_next" />
    </LinearLayout>

</FrameLayout>
