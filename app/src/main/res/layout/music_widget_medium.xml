<?xml version="1.0" encoding="utf-8"?>
<!-- 4x2: Portada cuadrada izquierda + columna derecha con título/artista/álbum
          + controles completos + barra de progreso fina + favorito. -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:padding="14dp">

    <!-- Portada ocupa toda la altura disponible -->
    <ImageView
        android:id="@+id/widget_album_art"
        android:layout_width="110dp"
        android:layout_height="match_parent"
        android:layout_alignParentStart="true"
        android:background="@drawable/widget_album_art_bg"
        android:clipToOutline="true"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_monkey_head" />

    <!-- Columna derecha -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="14dp"
        android:layout_toEndOf="@id/widget_album_art"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <!-- Fila: título + favorito -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/widget_song_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_toStartOf="@+id/widget_favorite"
                android:layout_marginEnd="6dp"
                android:ellipsize="end"
                android:singleLine="true"
                android:text="Monkey Player"
                android:textColor="#FFFFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/widget_favorite"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="@android:color/transparent"
                android:contentDescription="Favorite"
                android:padding="2dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_favorite_border" />
        </RelativeLayout>

        <TextView
            android:id="@+id/widget_song_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:singleLine="true"
            android:text="Not playing"
            android:textColor="#BBFFFFFF"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/widget_song_album"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="#66FFFFFF"
            android:textSize="11sp" />

        <!-- Barra de progreso -->
        <ProgressBar
            android:id="@+id/widget_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_marginTop="10dp"
            android:max="1000"
            android:progress="0"
            android:progressBackgroundTint="#33FFFFFF"
            android:progressTint="#FFFFFFFF" />

        <!-- Tiempos -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp">

            <TextView
                android:id="@+id/widget_time_current"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:text="0:00"
                android:textColor="#55FFFFFF"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/widget_time_total"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:text="0:00"
                android:textColor="#55FFFFFF"
                android:textSize="10sp" />
        </RelativeLayout>

        <!-- Controles -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="start"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/widget_prev"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/widget_btn_secondary_bg"
                android:contentDescription="Previous"
                android:padding="7dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_skip_previous" />

            <ImageButton
                android:id="@+id/widget_play_pause"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/widget_btn_bg"
                android:contentDescription="Play/Pause"
                android:padding="9dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_play"
                android:tint="#FF000000" />

            <ImageButton
                android:id="@+id/widget_next"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/widget_btn_secondary_bg"
                android:contentDescription="Next"
                android:padding="7dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_skip_next" />
        </LinearLayout>
    </LinearLayout>

</RelativeLayout>
