<?xml version="1.0" encoding="utf-8"?>
<!-- 2x1: Compacto. Portada redondeada + título/artista + botón play/pause prominente. -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:padding="10dp">

    <!-- Portada -->
    <ImageView
        android:id="@+id/widget_album_art"
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:layout_alignParentStart="true"
        android:layout_centerVertical="true"
        android:background="@drawable/widget_album_art_bg"
        android:clipToOutline="true"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_monkey_head" />

    <!-- Botón play/pause: círculo blanco con icono negro -->
    <ImageButton
        android:id="@+id/widget_play_pause"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"
        android:background="@drawable/widget_btn_bg"
        android:contentDescription="Play/Pause"
        android:padding="9dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_play"
        android:tint="#FF000000" />

    <!-- Texto: título + artista -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_marginEnd="8dp"
        android:layout_marginStart="10dp"
        android:layout_toEndOf="@id/widget_album_art"
        android:layout_toStartOf="@id/widget_play_pause"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_song_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="marquee"
            android:marqueeRepeatLimit="marquee_forever"
            android:scrollHorizontally="true"
            android:singleLine="true"
            android:text="Monkey Player"
            android:textColor="#FFFFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_song_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:text="Not playing"
            android:textColor="#99FFFFFF"
            android:textSize="11sp" />
    </LinearLayout>

</RelativeLayout>
