<?xml version="1.0" encoding="utf-8"?>
<!-- Fondo del widget: negro profundo con opacidad alta y bordes bien redondeados.
     El borde sutil da sensación de "glass" sin necesitar BlurMaskFilter. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <solid android:color="#F0101010" />
    <corners android:radius="24dp" />
    <stroke
        android:width="1dp"
        android:color="#30FFFFFF" />
</shape>
